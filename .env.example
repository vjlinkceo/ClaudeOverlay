# OpenAI API key: https://platform.openai.com/api-keys
# You can also enter or replace it in Settings -> Model -> API key.
# On startup the key is encrypted with Windows DPAPI into openai_api_key.dpapi,
# and the plaintext value is cleared from this file.
OPENAI_API_KEY=

# Optional, only for Anthropic models. The original api_key.dpapi remains supported.
ANTHROPIC_API_KEY=

# Optional: Hugging Face token for local speech-model downloads.
# HF_TOKEN=
